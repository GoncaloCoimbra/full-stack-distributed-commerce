# Infrastructure services
MONGO_INITDB_DATABASE=change-me
POSTGRES_DB=change-me
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
CLICKHOUSE_DB=change-me
CLICKHOUSE_USER=change-me
CLICKHOUSE_PASSWORD=

# Application URLs and persistence
MONGODB_URI=mongodb://mongo:27017/change-me
DATABASE_URL=postgresql://change-me:change-me@postgres:5432/change-me
DATABASE_URL_READ_REPLICA=postgresql://change-me:change-me@postgres:5432/change-me
REDIS_URL=redis://redis:6379
CLICKHOUSE_HTTP_URL=http://clickhouse:8123
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
BACKEND_PORT=3001
FRONTEND_PORT=5173

# Runtime controls
NODE_ENV=production
APP_SHUTDOWN_TIMEOUT_MS=10000
SEED_DATA_PATH=/app/data/product-families.json

# Secrets and crypto
JWT_SECRET=replace-with-a-secure-random-secret
JWT_REFRESH_SECRET=replace-with-a-secure-random-refresh-secret
FIELD_ENCRYPTION_KEY=change-me

# Operational tuning
REDIS_MAX_RETRIES=5
BULK_IMPORT_BATCH_SIZE=250
CACHE_TTL_MS=300000
